    {
        "id": "d24199558e6e5de5",
        "type": "function",
        "z": "09827af2b4426f0a",
        "name": "POWER ALARM",
        "func": "let limit = 500;\n\n// Check if total power exceeds the limit\nif (msg.payload > limit) {\n    msg.payload = \"⚠️ WARNING: Total power is above 500 W!\";\n    return msg;\n}\n\n// Do not send a message if power is within the limit\nreturn null;\n",
