    {
        "id": "79c750e4974eab2a",
        "type": "function",
        "z": "09827af2b4426f0a",
        "name": "CALCULATE THE TOTALPOWER",
        "func": "// Retrieve saved appliance states\nlet ironBox = flow.get(\"ironBox\") || false;\nlet fan = flow.get(\"fan\") || false;\nlet tv = flow.get(\"tv\") || false;\nlet fridge = flow.get(\"fridge\") || false;\n\n// Check which appliance sent the message and update its state\nif (msg.topic === \"ironBox\") {\n    ironBox = Boolean(msg.payload);\n    flow.set(\"ironBox\", ironBox);\n}\nelse if (msg.topic === \"fan\") {\n    fan = Boolean(msg.payload);\n    flow.set(\"fan\", fan);\n}\nelse if (msg.topic === \"tv\") {\n    tv = Boolean(msg.payload);\n    flow.set(\"tv\", tv);\n}\nelse if (msg.topic === \"fridge\") {\n    fridge = Boolean(msg.payload);\n    flow.set(\"fridge\", fridge);\n}\n\n// Calculate the total power consumption\nlet totalPower = 0;\n\nif (ironBox) totalPower += 100;\nif (fan) totalPower += 150;\nif (tv) totalPower += 120;\nif (fridge) totalPower += 300;\n\n// Set output message\nmsg.payload = totalPower;\nmsg.topic = \"Power\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 240,
        "wires": [
