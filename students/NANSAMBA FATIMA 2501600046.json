    {
        "id": "432b9975af4e1b08",
        "type": "function",
        "z": "c6503ea60c3640ab",
        "name": "Calculate Total Power",
        "func": "// Get the current appliance states\nlet states = flow.get(\"applianceStates\") || {\n    light: false,\n    fan: false,\n    tv: false,\n    fridge: false,\n    \n};\n\n// Update the state of the appliance that sent the message\nstates[msg.topic] = msg.payload;\n\n// Save the updated states\nflow.set(\"applianceStates\", states);\n\n// Power ratings\nlet power = {\n    light: 90,\n    fan: 150,\n    tv: 120,\n    fridge: 200,\n    \n};\n\n// Calculate total power\nlet total = 0;\n\nif (states.light) total += power.light;\nif (states.fan) total += power.fan;\nif (states.tv) total += power.tv;\nif (states.fridge) total += power.fridge;\n\n// Send total power\nmsg.payload = total;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 120,
        "wires": [
            [
                "0b527ff5b628314b",
                "ce95061ed02c9421",
                "8fbbcf69c3d9af13",
                "840a94fb677f28bf"
            ]
        ]
    },
