    {
        "id": "7d82b3b29bf3cd6f",
        "type": "function",
        "z": "e94e09b52c1de708",
        "name": "Calcuate Total Power",
        "func": "// Remember the latest power value for each appliance\nif (msg.topic === \"lights\") {\n    flow.set(\"lights\", msg.payload);\n}\n\nif (msg.topic === \"tv\") {\n    flow.set(\"tv\", msg.payload);\n}\n\nif (msg.topic === \"fridge\") {\n    flow.set(\"fridge\", msg.payload);\n}\n\nif (msg.topic === \"ac\") {\n    flow.set(\"ac\", msg.payload);\n}\n\n// Get the latest values\nlet lights = flow.get(\"lights\") || 0;\nlet tv = flow.get(\"tv\") || 0;\nlet fridge = flow.get(\"fridge\") || 0;\nlet ac = flow.get(\"ac\") || 0;\n\n// Calculate total\nlet totalpower = lights + tv + fridge + ac;\n\nflow.set(\"totalpower\",totalpower);\n\nmsg.payload = totalpower;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
