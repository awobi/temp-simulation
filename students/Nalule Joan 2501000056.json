    {
        "id": "98183ab9f48518d1",
        "type": "function",
        "z": "e410434d199c1bd9",
        "name": " total power",
        "func": "let states = context.get(\"states\") || {\n    ac: false,\n   fridge: false,\n    tv: false,\n    lights: false\n};\n\n// Convert the switch value to ON/OFF\nlet isOn = Number(msg.payload) === 1;\n\n// Update the appliance\nif (msg.topic === \"ac\") {\n    states.ac = isOn;\n}\n\nif (msg.topic === \"fridge\") {\n    states.fridge = isOn;\n}\n\nif (msg.topic === \"tv\") {\n    states.tv = isOn;\n}\n\nif (msg.topic === \"lights\") {\n    states.lights = isOn;\n}\n\n// Save appliance states\ncontext.set(\"states\", states);\n\n// Calculate total power\nlet totalPower = 0;\n\nif (states.ac) {\n    totalPower += 100;\n}\n\nif (states.fridge) {\n    totalPower += 200;\n}\n\nif (states.tv) {\n    totalPower += 150;\n}\n\nif (states.lights) {\n    totalPower += 300;\n}\n\n// Send total power\nmsg.payload = totalPower;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 180,
        "wires": [
