    {
        "id": "76803797c158c6e2",
        "type": "function",
        "z": "03aabaa19dec53a9",
        "name": "Power Limit Monitor",
        "func": "let totalPower = Number(msg.payload);\nlet powerLimit = Number(flow.get(\"powerLimit\") || 400);\n\nif (totalPower > powerLimit) {\n\n    msg.payload =\n        \"⚠ HIGH POWER ALERT! Total power is \" +\n        totalPower +\n        \" W, exceeding the limit of \" +\n        powerLimit +\n        \" W.\";\n\n    msg.topic = \"HIGH_POWER\";\n}else if(totalPower == 0){\n    msg.payload = \"Power Off\";\n}else {\n\n    msg.payload =\n        \"✓ Power consumption is normal: \" +\n        totalPower +\n        \" W.\";\n\n    msg.topic = \"NORMAL\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
