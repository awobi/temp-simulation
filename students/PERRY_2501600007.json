    {
        "id": "cef12aac2367a003",
        "type": "function",
        "z": "03aabaa19dec53a9",
        "name": "Calculate Total Power",
        "func": "// Get current appliance states\nlet light = flow.get(\"light\") || false;\nlet television = flow.get(\"television\") || false;\nlet refrigerator = flow.get(\"refrigerator\") || false;\nlet fan = flow.get(\"fan\") || false;\n\n// Update the appliance that sent the message\nif (msg.topic === \"light\") {\n    light = msg.payload;\n    flow.set(\"light\", light);\n}\n\nif (msg.topic === \"television\") {\n    television = msg.payload;\n    flow.set(\"television\", television);\n}\n\nif (msg.topic === \"refrigerator\") {\n    refrigerator = msg.payload;\n    flow.set(\"refrigerator\", refrigerator);\n}\n\nif (msg.topic === \"fan\") {\n    fan = msg.payload;\n    flow.set(\"fan\", fan);\n}\n\n// Appliance rated powers\nconst LIGHT_POWER = 60;\nconst TELEVISION_POWER = 120;\nconst REFRIGERATOR_POWER = 250;\nconst FAN_POWER = 75;\n\n// Calculate power\nlet totalPower = 0;\n\nif (light) {\n    totalPower += LIGHT_POWER;\n}\n\nif (television) {\n    totalPower += TELEVISION_POWER;\n}\n\nif (refrigerator) {\n    totalPower += REFRIGERATOR_POWER;\n}\n\nif (fan) {\n    totalPower += FAN_POWER;\n}\n\n// Save total power\nflow.set(\"totalPower\", totalPower);\n\n// Send total power\nmsg.payload = totalPower;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 360,
        "wires": [
