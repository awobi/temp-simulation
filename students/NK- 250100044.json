    {
        "id": "b3f50a54a697916b",
        "type": "function",
        "z": "f409e2d7b4510338",
        "name": "function 1",
        "func": "let tv = flow.get(\"TV\") || false;\nlet fridge = flow.get(\"Fridge\") || false;\nlet fan = flow.get(\"Fan\") || false;\nlet iron = flow.get(\"Iron\") || false;\n\nif (msg.topic === \"TV\") {\n    tv = msg.payload;\n    flow.set(\"TV\", tv);\n}\n\nif (msg.topic === \"Fridge\") {\n    fridge = msg.payload;\n    flow.set(\"Fridge\", fridge);\n}\n\nif (msg.topic === \"Fan\") {\n    fan = msg.payload;\n    flow.set(\"Fan\", fan);\n}\n\nif (msg.topic === \"Iron\") {\n    iron = msg.payload;\n    flow.set(\"Iron\", iron);\n}\n\nmsg.payload = (tv ? 100 : 0) +\n              (fridge ? 200 : 0) +\n              (fan ? 75 : 0) +\n              (iron ? 1000 : 0);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
