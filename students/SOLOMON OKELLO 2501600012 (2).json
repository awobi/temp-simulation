    {
        "id": "2086cbfc4ddf52a7",
        "type": "function",
        "z": "c6c23b35f849c8f3",
        "name": "CALCULATE TOTAL POWER",
        "func": "\nlet light = flow.get(\"light\") || false;\nlet fan = flow.get(\"fan\") || false;\nlet tv = flow.get(\"tv\") || false;\nlet fridge = flow.get(\"fridge\") || false;\n\n\nif (msg.topic === \"light\") {\n    light = Boolean(msg.payload);\n    flow.set(\"light\", light);\n}\n\nif (msg.topic === \"fan\") {\n    fan = Boolean(msg.payload);\n    flow.set(\"fan\", fan);\n}\n\nif (msg.topic === \"tv\") {\n    tv = Boolean(msg.payload);\n    flow.set(\"tv\", tv);\n}\n\nif (msg.topic === \"fridge\") {\n    fridge = Boolean(msg.payload);\n    flow.set(\"fridge\", fridge);\n}\n\n\nlet totalPower =\n    (light ? 100 : 0) +\n    (fan ? 150 : 0) +\n    (tv ? 120 : 0) +\n    (fridge ? 300 : 0);\n\n\nmsg.payload = totalPower;\nmsg.topic = \"Power\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 120,
        "wires": [
