    {
        "id": "2baa153cf50df4fa",
        "type": "function",
        "z": "dead6055922d1c14",
        "name": "CURRENT TOTAL POWER",
        "func": "let states = context.get(\"states\") || {\n    lights: false,\n    fan: false,\n    frigde: false,\n    TV: false\n};\n\n// Convert the switch value to ON/OFF\nlet isOn = Number(msg.payload) === 1;\n\n// Update the appliance\nif (msg.topic === \"lights\") {\n    states.lights = isOn;\n}\n\nif (msg.topic === \"fan\") {\n    states.fan = isOn;\n}\n\nif (msg.topic === \"frigde\") {\n    states.frigde = isOn;\n}\n\nif (msg.topic === \"TV\") {\n    states.TV = isOn;\n}\n\n// Save appliance states\ncontext.set(\"states\", states);\n\n// Calculate total power\nlet totalPower = 0;\n\nif (states.lights) {\n    totalPower += 100;\n}\n\nif (states.fan) {\n    totalPower += 200;\n}\n\nif (states.frigde) {\n    totalPower += 150;\n}\n\nif (states.TV) {\n    totalPower += 300;\n}\n\n// Send total power\nmsg.payload = totalPower;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
