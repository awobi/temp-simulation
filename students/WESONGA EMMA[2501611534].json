    {
        "id": "fn_check_alarm",
        "type": "function",
        "z": "tab_energy_monitor",
        "name": "Check Threshold",
        "func": "let limit = flow.get(\"powerThreshold\") || 3500;\nlet currentPower = msg.payload;\n\nif (currentPower > limit) {\n    msg.payload = \"ALERT: Power consumption (\" + currentPower + \"W) exceeded set limit of \" + limit + \"W!\";\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
