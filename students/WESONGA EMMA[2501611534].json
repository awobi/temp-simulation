    {
        "id": "fn_calc_power",
        "type": "function",
        "z": "tab_energy_monitor",
        "name": " Total Power",
        "func": "const powerRatings = {\n    \"AC\": 1200,\n    \"Refrigerator\": 200,\n    \"Heater\": 1500,\n    \"Lighting Bulbs\": 100,\n    \"Washing Machine\": 1000,\n};\n\nlet states = flow.get(\"applianceStates\") || {\n    \"AC\": false,\n    \"Refrigerator\": false,\n    \"Heater\": false,\n    \"Lighting Bulbs\": false,\n    \"Washing Machine\":false,\n};\n\nif (msg.topic && powerRatings.hasOwnProperty(msg.topic)) {\n    states[msg.topic] = Boolean(msg.payload);\n    flow.set(\"applianceStates\", states);\n}\n\nlet total = 0;\nfor (let app in states) {\n    if (states[app]) total += powerRatings[app];\n}\n\nmsg.payload = total;\nmsg.topic = \"Total Power\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 190,
        "wires": [
            [
                "gauge_power",
                "chart_power",
                "fn_check_alarm"
            ]
        ]
    },
