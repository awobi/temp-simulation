    {
        "id": "5adcee71873e09e9",
        "type": "function",
        "z": "5dc036f2121256f3",
        "name": "calculate total power",
        "func": "// Get the current appliance states\nlet states = flow.get(\"applianceStates\") || {\n    tv: false,\n    fridge: false,\n    cooker: false,\n    laptop: false,\n};\n\n// Update the state of the appliance that sent the message\nstates[msg.topic] = msg.payload;\n\n// Save the updated states\nflow.set(\"applianceStates\", states);\n\n// Power ratings\nlet power = {\n    tv: 120,\n    fridge: 200,\n    cooker:1500,\n    laptop:1000,\n};\n\n// Calculate total power\nlet total = 0;\nif (states.tv) total += power.tv;\nif (states.fridge) total += power.fridge;\nif (states.cooker) total += power.cooker;\nif (states.laptop) total += power.laptop;\n// Send total power\nmsg.payload = total;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 160,
        "wires": [
            [
                "f015a04881da4143",
                "454a13cd8ef878e8",
                "9cce288fa5b67e8a",
                "f357945fb0a364de"
            ]
