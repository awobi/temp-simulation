    {
        "id": "18782f58f5f458f0",
        "type": "function",
        "z": "2de9861d65d4124f",
        "name": "calculate total power",
        "func": "  // 1. Initialize context memory to track each appliance\nlet powerStates = context.get('powerStates') || {\n    \"light\": 0,\n    \"fan\": 0,\n    \"fridge\": 0,\n    \"tv\": 0\n};\n\n// 2. Update the specific appliance wattage that just\nif (msg.topic) {\n    powerStates[msg.topic] = Number(msg.payload);\n}\n\ncontext.set('powerStates', powerStates);\n\n// 4. Calculate the sum total of all running appliance\nlet totalPower = powerStates.light+\n    powerStates.fan +\n    powerStates.fridge +\n    powerStates.tv;\nmsg.payload=totalPower;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 200,
        "wires": [
