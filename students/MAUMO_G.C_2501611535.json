    {
        "id": "d0f532901a24554d",
        "type": "function",
        "z": "141a38c29fe48d87",
        "name": "total power calculater",
        "func": "// Get current appliance states\nlet light = flow.get(\"light\") || false;\nlet television = flow.get(\"television\") || false;\nlet cooker = flow.get(\"cooker\") || false;\nlet air_conditioner = flow.get(\"air_conditioner\") || false;\n\n// Update the appliance that sent the message\nif (msg.topic === \"light\") {\n    light = msg.payload;\n    flow.set(\"light\", light);\n}\n\nif (msg.topic === \"television\") {\n    television = msg.payload;\n    flow.set(\"television\", television);\n}\n\nif (msg.topic === \"cooker\") {\n    cooker = msg.payload;\n    flow.set(\"cooker\", cooker);\n}\n\nif (msg.topic === \"air_conditioner\") {\n    air_conditioner = msg.payload;\n    flow.set(\"air_conditioner\", air_conditioner);\n}\n\n// Appliance rated powers\nconst LIGHT_POWER = 80;\nconst TELEVISION_POWER = 160;\nconst COOKER_POWER = 500;\nconst AIR_CONDITIONER_POWER = 350;\n\n// Calculate power\nlet totalPower = 0;\n\nif (light) {\n    totalPower += LIGHT_POWER;\n}\n\nif (television) {\n    totalPower += TELEVISION_POWER;\n}\n\nif (cooker) {\n    totalPower += COOKER_POWER;\n}\n\nif (air_conditioner) {\n    totalPower += AIR_CONDITIONER_POWER;\n}\n\n// Save total power\nflow.set(\"totalPower\", totalPower);\n\n// Send total power\nmsg.payload = totalPower;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 360,
        "wires": [
            [
                "db3f7d5fa7b7d914",
                "3fba3bd15407b25b",
                "9cfa590cd7eb8f1c"
            ]
        ]
    },
