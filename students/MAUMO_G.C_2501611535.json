    {
        "id": "9cfa590cd7eb8f1c",
        "type": "function",
        "z": "141a38c29fe48d87",
        "name": "limit monitor",
        "func": "let totalPower = Number(msg.payload);\nlet powerLimit = Number(flow.get(\"powerLimit\") || 1362.5);\n\nif (totalPower > powerLimit) {\n\n    msg.payload =\n        \"⚠ HIGH POWER ALERT! Total power is \" +\n        totalPower +\n        \" W, exceeding the limit of \" +\n        powerLimit +\n        \" W.\";\n\n    msg.topic = \"HIGH_POWER\";\n}else if(totalPower == 0){\n    msg.payload = \"Power Off\";\n}else {\n\n    msg.payload =\n        \"✓ Power consumption is normal: \" +\n        totalPower +\n        \" W.\";\n\n    msg.topic = \"NORMAL\";\n}\n\nreturn msg;",
        "outputs": 1,
