    {
        "id": "ea2a1de615d36ef8",
        "type": "function",
        "z": "fb70c5083377c99c",
        "name": "Generate Appliance Power Consumption",
        "func": "// Appliance rated powers in Watts\nconst ratings = {\n    fan: 75,\n    light: 15,\n    ac: 1200,\n    fridge: 150\n};\n\n// Store the current power of each appliance\ncontext.appliances = context.appliances || {\n    fan: 0,\n    light: 0,\n    ac: 0,\n    fridge: 0\n};\n\n// Check that the message belongs to a known appliance\nif (msg.topic && ratings.hasOwnProperty(msg.topic)) {\n\n    // Appliance is ON\n    if (msg.payload === true || msg.payload === 1 || msg.payload === \"ON\") {\n        context.appliances[msg.topic] = ratings[msg.topic];\n    }\n\n    // Appliance is OFF\n    else if (msg.payload === false || msg.payload === 0 || msg.payload === \"OFF\") {\n        context.appliances[msg.topic] = 0;\n    }\n\n    // If an actual power value is sent, use that value\n    else if (!isNaN(Number(msg.payload))) {\n        context.appliances[msg.topic] = Number(msg.payload);\n    }\n}\n\n\n// Calculate total power\nlet total = 0;\n\nfor (let name in context.appliances) {\n    total += Number(context.appliances[name]) || 0;\n}\n\n\n// Output\nmsg.payload = total;\nmsg.topic = \"power\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 160,
        "wires": [
            [
                "d1c26fb9309a1011",
                "426d4ce44c856f52"
            ]
        ]
    },
