    {
        "id": "07a08666f7c126d4",
        "type": "function",
        "z": "9406aa516094c2fe",
        "name": "Calculate Total Power",
        "func": "const appliances = {\n    \"Living Room Light\": 60,\n    \"Television\": 120,\n    \"Electric Fan\": 75,\n    \"Refrigerator\": 150\n};\n\nlet states = flow.get(\"applianceStates\") || {\n    \"Living Room Light\": 0,\n    \"Television\": 0,\n    \"Electric Fan\": 0,\n    \"Refrigerator\": 0\n};\n\nif (msg.topic && appliances[msg.topic] !== undefined) {\n    states[msg.topic] = Number(msg.payload) ? 1 : 0;\n    flow.set(\"applianceStates\", states);\n}\n\nlet total = 0;\n\nfor (const name in appliances) {\n    total += appliances[name] * states[name];\n}\n\nflow.set(\"totalPower\", total);\n\nconst output = {\n    payload: total,\n    topic: \"Total Power\",\n    timestamp: Date.now()\n};\n\nconst LIMIT = 300;\n\nlet alarm = null;\n\nif (total > LIMIT) {\n    alarm = {\n        payload: `POWER ALERT: Total power is ${total} W, above the ${LIMIT} W limit.`,\n        topic: \"Power Alarm\"\n    };\n}\n\nreturn [output, alarm];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 280,
        "wires": [
            [
                "dd5669e23f15077a",
                "7c63743c8255075c",
                "baf69e8e17776ef5",
                "8da4907d7cb79e39"
            ]
