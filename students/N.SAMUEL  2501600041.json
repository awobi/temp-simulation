    {
        "id": "285f46821392a81d",
        "type": "function",
        "z": "122e32a5737ac271",
        "name": "Calculate total Power",
        "func": "// Wattage rating for each appliance\nconst wattages = {\n    fridge: 1500,\n    fan: 1200,\n    heater: 150,\n    tv: 100\n};\n\n// Persisted on/off state for every appliance\nlet state = context.get('state') || { fridge: false, ac: false, heater: false, tv: false };\n\n// Update state only when a real switch message arrives (not the tick)\nif (msg.topic !== 'tick' && wattages.hasOwnProperty(msg.topic)) {\n    state[msg.topic] = msg.payload;\n    context.set('state', state);\n}\n\n// Sum wattage of every appliance currently ON\nlet total = 0;\nfor (const key in state) {\n    if (state[key]) {\n        total += wattages[key];\n    }\n}\n\nmsg.payload = total;\nmsg.topic = 'power';\nreturn msg;\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
        "wires": [
            [
                "60d7121ffbf32eab",
                "076e6c89aa2dc5e5",
                "a4b6265ef56a961a"
            ]
        ]
    },
