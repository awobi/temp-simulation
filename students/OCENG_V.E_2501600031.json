    {
        "id": "534eae4659c86f5a",
        "type": "function",
        "z": "88d367229ff9706c",
        "name": "function 1",
        "func": "// Initialize stored values safely\ncontext.lightVal = context.lightVal !== undefined ? context.lightVal : 0;\ncontext.fanVal = context.fanVal !== undefined ? context.fanVal : 0;\ncontext.tvVal = context.tvVal !== undefined ? context.tvVal : 0;\ncontext.fridgeVal = context.fridgeVal !== undefined ? context.fridgeVal : 0;\n\nlet topic = (msg.topic || \"\").toLowerCase();\n\nif (topic === \"light\") {\n    context.lightVal = msg.payload;\n} else if (topic === \"fan\") {\n    context.fanVal = msg.payload;\n} else if (topic === \"tv\") {\n    context.tvVal = msg.payload;\n} else if (topic === \"fridge\") {\n    context.fridgeVal = msg.payload;\n}\n\n// Calculate total power sum\nmsg.payload = context.lightVal + context.fanVal + context.tvVal + context.fridgeVal;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
