    {
        "id": "8320adb5b846033c",
        "type": "function",
        "z": "545d14cbc946c27e",
        "name": "function 1",
        "func": "let speaker = flow.get(\"Speaker\") || false;\nlet tv = flow.get(\"TV\") || false;\nlet fan = flow.get(\"Fan\") || false;\nlet fridge = flow.get(\"Fridge\") || false;\n\nif (msg.topic === \"Speaker\") {\n    speaker = msg.payload;\n    flow.set(\"Speaker\", speaker);\n}\n\nif (msg.topic === \"TV\") {\n    tv = msg.payload;\n    flow.set(\"TV\", tv);\n}\n\nif (msg.topic === \"Fan\") {\n    fan = msg.payload;\n    flow.set(\"Fan\", fan);\n}\n\nif (msg.topic === \"Fridge\") {\n    fridge = msg.payload;\n    flow.set(\"Frigde\", fridge );\n}\n\nmsg.payload = (speaker ? 100 : 0) +\n              (tv ? 200 : 0) +\n              (fan ? 75 : 0) +\n              (fridge ? 1000 : 0);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
